# EvoLLM — API Keys
# Copia este archivo como .env y rellena tus claves.
# El archivo .env nunca debe subirse al repositorio.

# OpenAI (modelos GPT; también el conversor fijo GPT-5.4 Mini de la Fase 2)
OPENAI_API_KEY=sk-...

# Anthropic (modelos Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio (modelos Gemini)
GOOGLE_API_KEY=AIza...

# OpenRouter — pasarela compatible con OpenAI para los modelos chinos de la
# Fase 2 (DeepSeek V4, Qwen 3.6, Kimi K2.6, GLM-5.1). No requiere cuenta en
# nubes chinas. Para usar Vercel AI Gateway en lugar de OpenRouter, define
# OPENROUTER_BASE_URL con la URL del gateway.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
