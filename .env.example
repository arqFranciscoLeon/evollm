# EvoLLM — API Keys
# Copia este archivo como .env y rellena tus claves.
# El archivo .env nunca debe subirse al repositorio.

# OpenAI (necesario para modelos GPT-4o, o4-mini)
OPENAI_API_KEY=sk-...

# Anthropic (necesario para Claude Sonnet 4.5, Claude Opus 4)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio (necesario para Gemini 2.0 Flash)
GOOGLE_API_KEY=AIza...
